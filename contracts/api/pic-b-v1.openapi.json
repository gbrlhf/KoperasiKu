{
  "openapi": "3.1.0",
  "info": {
    "title": "KoperasiKu - PIC B Core API",
    "version": "1.2.0",
    "description": "Root Laravel application. Same-origin authenticated web session; use the CSRF token supplied by Laravel. Role selection is restricted to roles assigned in the database. Contract draft: requires PostgreSQL and browser regression validation."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Authentication, authorization, validation, conflict or internal error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error_code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "MEMBER",
                      "CASHIER",
                      "MANAGER"
                    ]
                  }
                },
                "required": [
                  "password"
                ]
              }
            }
          }
        }
      }
    },
