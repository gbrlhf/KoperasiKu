# Copy .env.example to .env, generate APP_KEY, then copy .env to .env.testing.
# Apply these settings in .env.testing. Do not commit that file.
APP_ENV=testing
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=koperadata_test
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL=
SESSION_DRIVER=file
CACHE_STORE=array
QUEUE_CONNECTION=sync
