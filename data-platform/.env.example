# Copy to data-platform/.env and fill in (never commit secrets).
# RO credentials for PIC B/C operational public.*
PICD_SOURCE_DSN=postgresql://picd_reader:CHANGE_ME@127.0.0.1:5432/koperadata
# Only analytics schema write privilege; separate credentials recommended
PICD_WAREHOUSE_DSN=postgresql://picd_writer:CHANGE_ME@127.0.0.1:5432/koperadata
PICD_PSEUDONYM_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET_AT_LEAST_32_CHARS
PICD_MINIO_ENDPOINT=http://127.0.0.1:9000
PICD_MINIO_ACCESS_KEY=CHANGE_ME
PICD_MINIO_SECRET_KEY=CHANGE_ME
PICD_MINIO_BUCKET=koperadata-analytics
PICD_SPARK_MASTER=local[*]
PICD_OUTPUT_DIR=.runtime
PICD_TIMEZONE=Asia/Jakarta
PICD_AS_OF_DATE=

# Confirmed stock opening cut-off, YYYY-MM-DD. Empty means unknown.
PICD_STOCK_CUTOFF=
